# -- Home server Postgres (Tailscale / direct IP) ------------------------------
# Make sure the home server and its Docker container are running before switching.
# ${VAR} values are read from the root .env (never commit real values here).
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=${HOMESERVER_DB_PASSWORD}
DB_HOST=${HOMESERVER_DB_HOST}
DB_PORT=5433
DB_CONNECT_TIMEOUT=10
