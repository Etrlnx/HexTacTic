# -- Local Docker Postgres (database/docker-compose.yml) ----------------------
# Start container first:  docker compose --env-file .env -f database/docker-compose.yml up -d
# ${VAR} values are read from the root .env (never commit real values here).
DB_NAME=hextactic
DB_USER=hextactic
DB_PASSWORD=${LOCAL_DB_PASSWORD}
DB_HOST=127.0.0.1
DB_PORT=5433
DB_CONNECT_TIMEOUT=5
